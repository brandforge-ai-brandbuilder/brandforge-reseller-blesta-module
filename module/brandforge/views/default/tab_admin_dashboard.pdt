<?php if (!$has_service): ?>
    <div class="alert alert-info d-flex align-items-start" role="alert">
        <i class="bi bi-info-circle me-2 mt-1"></i>
        <div><?php echo Language::_('Brandforge.dashboard.no_service', true); ?></div>
    </div>
<?php else: ?>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <?php if ($sso_url !== ''): ?>
            <a href="<?php echo $this->Html->safe($sso_url); ?>" target="_blank" rel="noopener" class="btn btn-primary">
                <i class="bi bi-box-arrow-up-right me-1"></i>
                <?php echo Language::_('Brandforge.dashboard.launch', true, $brand_name); ?>
            </a>
        <?php endif; ?>
        <?php if ($workspace_sso_url !== ''): ?>
            <a href="<?php echo $this->Html->safe($workspace_sso_url); ?>" target="_blank" rel="noopener"
               class="btn btn-outline-secondary">
                <i class="bi bi-grid me-1"></i>
                <?php echo Language::_('Brandforge.dashboard.view_workspace', true); ?>
            </a>
        <?php endif; ?>
    </div>

    <?php if ($sso_error !== ''): ?>
        <div class="alert alert-warning d-flex align-items-start mb-3" role="alert">
            <i class="bi bi-exclamation-triangle me-2 mt-1"></i>
            <div><?php echo Language::_('Brandforge.dashboard.sso_unavailable', true, $sso_error); ?></div>
        </div>
    <?php endif; ?>

    <?php if ($has_usage_data): ?>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <h6 class="form-section-header"><?php echo Language::_('Brandforge.dashboard.credits', true); ?></h6>
                    <?php
                    $creditsPercent = $credits_allocated > 0
                        ? min(100, (int) round(($credits_used / $credits_allocated) * 100))
                        : 0;
                    ?>
                    <div class="progress mb-2" style="height: 0.5rem;">
                        <div class="progress-bar<?php echo $credits_over_limit ? ' bg-danger' : ''; ?>"
                             role="progressbar" style="width: <?php echo $creditsPercent; ?>%;"
                             aria-valuenow="<?php echo $creditsPercent; ?>" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="small text-body-secondary">
                        <?php echo Language::_('Brandforge.dashboard.credits_used_of', true, $credits_used, $credits_allocated); ?>
                        <?php if ($credits_period_end !== ''): ?>
                            &middot; <?php echo Language::_('Brandforge.dashboard.credits_resets', true, $credits_period_end); ?>
                        <?php endif; ?>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="border rounded p-3 h-100">
                    <h6 class="form-section-header"><?php echo Language::_('Brandforge.dashboard.workspaces', true); ?></h6>
                    <div class="small text-body-secondary">
                        <?php if ($workspaces_max > 0): ?>
                            <?php echo Language::_('Brandforge.dashboard.workspaces_active_of_max', true, $workspaces_active, $workspaces_max); ?>
                        <?php else: ?>
                            <?php echo Language::_('Brandforge.dashboard.workspaces_active_count', true, $workspaces_active); ?>
                        <?php endif; ?>
                    </div>
                </div>
            </div>
        </div>
    <?php else: ?>
        <p class="small text-body-secondary mb-3">
            <?php echo Language::_('Brandforge.dashboard.usage_unavailable', true); ?>
        </p>
    <?php endif; ?>

    <p class="small text-body-secondary mb-0">
        <?php echo Language::_('Brandforge.dashboard.service_id', true); ?>:
        <?php echo $this->Html->safe($service_id); ?>
    </p>

<?php endif; ?>
