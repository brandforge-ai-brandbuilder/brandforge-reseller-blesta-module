<?php /** @var View $this **/ ?>
<?php
/**
 * No module-row groups here (unlike cpanel's manage.pdt, which this is
 * modeled on) — BrandForge doesn't do round-robin/capacity-limited row
 * selection, a client always targets one specific Godmode Account.
 */
$link_buttons = [
    [
        'name' => $this->_('Brandforge.manage.add_module_row', true),
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . ($module->id ?? null)],
    ],
];

$this->Widget->clear();
$this->Widget->setLinkButtons($link_buttons);
$this->Widget->setBodyWrapper(false);
$this->Widget->create(
    $this->_(
        'AdminCompanyModules.manage.boxtitle_manage',
        true,
        isset($module->name) ? $this->Html->safe($module->name) : null
    ),
    ['id' => 'manage_brandforge']
);

$num_rows = count($module->rows ?? []);
?>

<p class="text-muted px-3 pt-3"><?php $this->_('Brandforge.manage.description'); ?></p>

<?php if ($num_rows > 0): ?>
    <table class="table">
        <thead>
            <tr>
                <th><span><?php $this->_('Brandforge.manage.module_rows_heading.name'); ?></span></th>
                <th><span><?php $this->_('Brandforge.manage.module_rows_heading.options'); ?></span></th>
            </tr>
        </thead>
        <tbody>
            <?php for ($i = 0; $i < $num_rows; $i++): ?>
                <tr>
                    <td><?php echo isset($module->rows[$i]->meta->api_url) ? $this->Html->safe($module->rows[$i]->meta->api_url) : null; ?></td>
                    <td>
                        <a href="<?php echo $this->Html->safe(
                            $this->base_uri . 'settings/company/modules/editrow/'
                            . ($module->id ?? null) . '/' . ($module->rows[$i]->id ?? null) . '/'
                        ); ?>" class="btn btn-sm btn-outline-secondary" title="<?php $this->_('Brandforge.manage.module_rows.edit'); ?>">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <?php
                        $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                        $this->Form->fieldHidden('id', $module->id ?? null);
                        $this->Form->fieldHidden('row_id', $module->rows[$i]->id ?? null);
                        ?>
                        <button type="button" class="btn btn-sm btn-outline-danger modal-confirm-delete"
                                data-confirm-message="<?php echo $this->Html->safe($this->_('Brandforge.manage.module_rows.confirm_delete', true)); ?>"
                                title="<?php $this->_('Brandforge.manage.module_rows.delete'); ?>">
                            <i class="bi bi-trash"></i>
                        </button>
                        <?php $this->Form->end(); ?>
                    </td>
                </tr>
            <?php endfor; ?>
        </tbody>
    </table>
<?php else: ?>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-hdd-rack" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 mb-0"><?php $this->_('Brandforge.manage.module_rows_no_results'); ?></p>
    </div>
<?php endif; ?>

<?php $this->Widget->end(); ?>
