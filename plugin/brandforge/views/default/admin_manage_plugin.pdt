<?php
/**
 * @var \stdClass $vars
 * @var array $errors
 * @var bool $saved
 * @var int|string|null $plugin_id
 * @var \stdClass[] $module_rows
 */
?>
<?php if (!empty($saved)): ?>
    <div class="alert alert-success" role="alert">
        <?php echo $this->_('AdminManagePlugin.flash.saved', true); ?>
    </div>
<?php endif; ?>
<?php if (!empty($errors)): ?>
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
            <?php foreach ($errors as $field_errors): ?>
                <?php foreach ((array) $field_errors as $message): ?>
                    <li><?php echo $this->Html->safe($message); ?></li>
                <?php endforeach; ?>
            <?php endforeach; ?>
        </ul>
    </div>
<?php endif; ?>

<form method="post" action="<?php echo $this->Html->safe($this->base_uri . 'settings/company/plugins/manage/' . ($plugin_id ?? '')); ?>">
    <input type="hidden" name="_csrf_token" value="<?php echo $this->Html->safe($this->Form->getCsrfToken()); ?>">

    <?php if (empty($module_rows)): ?>
        <div class="alert alert-warning d-flex align-items-start" role="alert">
            <i class="bi bi-exclamation-triangle me-2 mt-1"></i>
            <div><?php echo $this->_('AdminManagePlugin.field.module_row_id.none', true); ?></div>
        </div>
    <?php else: ?>
        <div class="mb-3">
            <label class="form-label" for="brandforge_module_row_id">
                <?php echo $this->_('AdminManagePlugin.field.module_row_id', true); ?>
            </label>
            <select class="form-select" id="brandforge_module_row_id" name="module_row_id">
                <option value=""><?php echo $this->_('AdminManagePlugin.field.module_row_id.placeholder', true); ?></option>
                <?php foreach ($module_rows as $row): ?>
                    <option value="<?php echo (int) $row->id; ?>"
                        <?php echo ((int) ($vars->module_row_id ?? 0) === (int) $row->id) ? 'selected' : ''; ?>>
                        #<?php echo (int) $row->id; ?> &mdash; <?php echo $this->Html->safe($row->meta->api_url ?? ''); ?>
                    </option>
                <?php endforeach; ?>
            </select>
            <div class="form-text"><?php echo $this->_('AdminManagePlugin.field.module_row_id.tooltip', true); ?></div>
        </div>
    <?php endif; ?>

    <hr class="my-4">

    <h6><?php echo $this->_('AdminManagePlugin.field.default_branding_heading', true); ?></h6>
    <p class="text-body-secondary small">
        <?php echo $this->_('AdminManagePlugin.field.default_branding_help', true); ?>
    </p>

    <div class="mb-3">
        <label class="form-label" for="brandforge_default_brand_name">
            <?php echo $this->_('AdminManagePlugin.field.default_brand_name', true); ?>
        </label>
        <input type="text" class="form-control" id="brandforge_default_brand_name" name="default_brand_name"
               placeholder="<?php echo $this->Html->safe($this->_('AdminManagePlugin.field.default_brand_name.placeholder', true)); ?>"
               value="<?php echo $this->Html->safe($vars->default_brand_name ?? ''); ?>">
    </div>

    <div class="row mb-3">
        <div class="col-sm-6">
            <label class="form-label" for="brandforge_default_brand_color">
                <?php echo $this->_('AdminManagePlugin.field.default_brand_color', true); ?>
            </label>
            <input type="color" class="form-control form-control-color" id="brandforge_default_brand_color"
                   name="default_brand_color"
                   value="<?php echo $this->Html->safe($vars->default_brand_color ?: '#6366f1'); ?>">
        </div>
        <div class="col-sm-6">
            <label class="form-label" for="brandforge_default_brand_color_secondary">
                <?php echo $this->_('AdminManagePlugin.field.default_brand_color_secondary', true); ?>
            </label>
            <input type="color" class="form-control form-control-color" id="brandforge_default_brand_color_secondary"
                   name="default_brand_color_secondary"
                   value="<?php echo $this->Html->safe($vars->default_brand_color_secondary ?: '#8b5cf6'); ?>">
        </div>
    </div>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="brandforge_debug_mode" name="debug_mode"
                   value="1" <?php echo !empty($vars->debug_mode) ? 'checked' : ''; ?>>
            <label class="form-check-label" for="brandforge_debug_mode">
                <?php echo $this->_('AdminManagePlugin.field.debug_mode', true); ?>
            </label>
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><?php echo $this->_('AdminManagePlugin.btn.save', true); ?></button>
</form>
